# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- Telegram MTProto credentials ---------------------------------------
# Obtain at https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=

# Base name of the Telethon session file, relative to the repo root.
# Produces ./tg_session.session after `just tg-auth`.
TG_SESSION_NAME=tg_session

# Optional guard: auth.py warns loudly if the logged-in account does not
# match this username. Leave empty to disable the check.
TG_EXPECTED_USERNAME=username

# --- Local PostgreSQL archive -------------------------------------------
# Port 5434 is used because 5432 and 5433 are taken by other local projects.
# Loopback only — see docs/70-ops/security.md.
DATABASE_URL=postgresql://tgai:tgai@127.0.0.1:5434/tgai

# --- Sync behaviour ------------------------------------------------------
# Archive 1-on-1 human chats only. Set to true to also archive bot chats.
TG_SYNC_INCLUDE_BOTS=false

# --- Client Identity: READ THIS, IT AFFECTS YOUR ACCOUNT ------------------
#
#   ##############################################################
#   #                     ANTI-BAN WARNING                       #
#   ##############################################################
#
# TG_LANG_CODE MUST match the interface language of the official Telegram
# app on your phone. If your Telegram app is in Spanish, set "es". In
# Russian, set "ru". In German, "de".
#
# The default below is "en" only because this is a public repository and no
# language can be hard-coded for everyone. It is NOT a safe value for you
# unless your Telegram app really is in English.
#
# Why it matters: every connection this client makes reports lang_code and
# system_lang_code to Telegram, alongside a phone number and an api_id that
# Telegram has already seen used from the official app for years. If the app
# says "ru" and this client says "en" on every single connection, that is a
# contradiction in Telegram's own records, on an account that unofficial-API
# use has already placed under observation. Matching costs nothing; not
# matching adds a signal for no benefit at all.
#
TG_LANG_CODE=en
TG_SYSTEM_LANG_CODE=en

# These three describe the machine. Honest and generic on purpose: this
# client never pretends to be Telegram Desktop, because Telegram knows from
# the api_id that it is not, and a lie it can check is worse than the truth.
#
# Leave them blank to derive sensible defaults ("Desktop", your real platform
# at major.minor precision, and "tg-ai 1.0"). Once a session exists, treat
# them as FROZEN: initConnection is replayed on every reconnection, so
# changing them makes the entry under Telegram -> Settings -> Devices mutate
# under you, which is both visible to support and a signal in itself.
TG_DEVICE_MODEL=
TG_SYSTEM_VERSION=
TG_APP_VERSION=

# --- Human activity window -----------------------------------------------
# An account that makes API calls uniformly around the clock is not a person.
# No Telegram-touching tool runs inside this window, and a sync refuses to
# start in it. Local time, in the timezone below.
TG_QUIET_HOURS=01:00-08:00

# IANA timezone name. Blank means "detect this machine's timezone", which is
# correct as long as the machine is the one the account owner actually uses.
TG_TIMEZONE=
