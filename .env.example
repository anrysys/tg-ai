# Copy to .env and fill in. .env is git-ignored — never commit it.

# --- Telegram MTProto credentials ---------------------------------------
# Obtain at https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=

# Base name of the Telethon session file, relative to the repo root.
# Produces ./tg_session.session after `just tg-auth`.
TG_SESSION_NAME=tg_session

# Optional guard: auth.py warns loudly if the logged-in account does not
# match this username. Leave empty to disable the check.
TG_EXPECTED_USERNAME=anrysys

# --- Local PostgreSQL archive -------------------------------------------
# Port 5434 is used because 5432 and 5433 are taken by other local projects.
# Loopback only — see docs/70-ops/security.md.
DATABASE_URL=postgresql://tgai:tgai@127.0.0.1:5434/tgai

# --- Sync behaviour ------------------------------------------------------
# Archive 1-on-1 human chats only. Set to true to also archive bot chats.
TG_SYNC_INCLUDE_BOTS=false
