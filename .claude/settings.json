{
  "permissions": {
    "allow": [
      "Bash(just:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec tg-ai-postgres:*)",
      "Bash(uv pip:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/python -m ruff:*)",
      "Bash(.venv/bin/python -m black:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./*.session)"
    ]
  }
}
